# Record type literal for type checking
RecordType = Literal[
    "A",
    "AAAA",
    "CAA",
    "CNAME",
    "DS",
    "HINFO",
    "HTTPS",
    "MX",
    "NS",
    "PTR",
    "RP",
    "SOA",
    "SRV",
    "SVCB",
    "TLSA",
    "TXT",
]
ZoneFileFormat = Literal["legacy", "rrsets"]


@dataclass
class Record:
    """DNS Record data structure with validation."""

    id: str
    type: RecordType
    name: str
    value: str
    comment: Optional[str] = None

    def __post_init__(self):
        """Validate record fields strictly based on DNS standards."""
        # Validate ID - should be a hexadecimal string of specific length or empty for new records
        if self.id:
            if not isinstance(self.id, str):
                raise ValueError("Record ID must be a string")

            # Hetzner record IDs are 32-char hex strings
            if not re.match(r"^[0-9a-f]{32}$", self.id):
                raise ValueError(f"Record ID '{self.id}' must be a 32-character hexadecimal string")

        # Validate record type
        if not self.type:
            raise ValueError("Record type cannot be empty")

        valid_record_types = [
            "A",
            "AAAA",
            "CAA",
            "CNAME",
            "DS",
            "HINFO",
            "HTTPS",
            "MX",
            "NS",
            "PTR",
            "RP",
            "SOA",
            "SRV",
            "SVCB",
            "TLSA",
            "TXT",
        ]
        if self.type not in valid_record_types:
            raise ValueError(f"Invalid record type: {self.type}. Must be one of {', '.join(valid_record_types)}")

        if not isinstance(self.name, str):
            raise ValueError("Record name must be a string")

        # Validate record name according to RFC 1035, plus allow underscores for service records (RFC 2181)
        # Allow @ as shorthand for apex/root of zone
        if self.name != "@":
            if not RE_SERVICE_RECORD_NAME.match(self.name):
                raise ValueError(f"Invalid record name format: {self.name}")

        if not self.value:
            raise ValueError("Record value cannot be empty")

        # Type-specific validation
        match self.type:
            case "A":
                # IPv4 address validation
                try:
                    ipaddress.IPv4Address(self.value)
                except ValueError:
                    raise ValueError(f"Invalid IPv4 address for A record: {self.value}")

            case "AAAA":
                # IPv6 address validation
                try:
                    ipaddress.IPv6Address(self.value)
                except ValueError:
                    raise ValueError(f"Invalid IPv6 address for AAAA record: {self.value}")

            case "MX":
                # MX records should have format "priority hostname"
                if not re.match(r"^\d+\s+\S+$", self.value):
                    raise ValueError(
                        f"Invalid MX record format: {self.value}. Expected format: '10 mail.example.com.'"
                    )

                # Extract priority and check if it's within valid range (0-65535)
                try:
                    priority = int(self.value.split()[0])
                    if priority < 0 or priority > 65535:
                        raise ValueError(f"Invalid MX priority: {priority}. Must be between 0 and 65535")
                except (ValueError, IndexError):
                    raise ValueError(f"Invalid MX priority in record: {self.value}")

            case "TXT":
                # TXT records should be quoted with proper format
                if not RE_TXT_PATTERN.fullmatch(self.value):
                    raise ValueError(f"Invalid TXT record format: {self.value}. Value should be quoted")

            case "SOA":
                # SOA records have a specific format with 7 parts
                parts = self.value.split(" ")
                if len(parts) != 7:
                    raise ValueError(
                        f"Invalid SOA record format: {self.value}. Expected format: 'primary_ns admin_email serial refresh retry expire minimum'"
                    )

                # Check if the serial, refresh, retry, expire, and minimum are numeric
                for i in range(2, 7):
                    try:
                        int(parts[i])
                    except ValueError:
                        raise ValueError(
                            "Invalid SOA record: numeric values required for serial, refresh, retry, expire, and minimum"
                        )

            case "CNAME":
                # CNAME records should point to a hostname
                if not self.value:
                    raise ValueError("CNAME record value cannot be empty")

                if not RE_FQDN_OR_RELATIVE.match(self.value):
                    raise ValueError(f"Invalid hostname format for CNAME record: {self.value}")

            case _:
                # Other record types have no specific validation beyond the basic checks above
                pass


@dataclass
class RRSet:
    """DNS resource record set keyed by name and type."""

    name: str
    type: RecordType
    records: List[Record] = field(default_factory=list)
    ttl: Optional[int] = None
    labels: Dict[str, str] = field(default_factory=dict)

    @property
    def id(self) -> str:
        """Return the Hetzner Cloud RRSet identifier."""
        return f"{self.name}/{self.type}"

    def __post_init__(self) -> None:
        if not isinstance(self.records, list):
            raise ValueError("RRSet records must be a list")

        normalized_records = []
        seen_values = set()
        for record in self.records:
            if record.name != self.name or record.type != self.type:
                raise ValueError(f"RRSet {self.id} contains mismatched record {record.name}/{record.type}")

            key = (record.value, record.comment)
            if key in seen_values:
                raise ValueError(f"Duplicate record found in RRSet {self.id}: {record.value}")
            seen_values.add(key)
            normalized_records.append(record)

        self.records = sorted(normalized_records, key=lambda r: (r.value, r.comment or ""))


@dataclass
class Zone:
    """DNS Zone data structure with validation."""

    id: str
    name: str
    records: List[Record] = field(default_factory=list)
    rrsets: List[RRSet] = field(default_factory=list)
    ttl: Optional[int] = None
    source_format: ZoneFileFormat = "rrsets"

    def __post_init__(self) -> None:
        """Validate zone fields strictly according to Hetzner DNS standards."""
        # Validate ID
        if not isinstance(self.id, str):
            raise ValueError("Zone ID must be a string")

        if not self.id:
            raise ValueError("Zone ID cannot be empty")

        # Old DNS API zone IDs are 21/22-char alphanumeric strings; Cloud API zone IDs are numeric.
        if not (re.match(r"^[a-zA-Z0-9]{21,22}$", self.id) or re.match(r"^\d+$", self.id)):
            raise ValueError(f"Zone ID '{self.id}' must be a numeric or 21/22-character alphanumeric string")

        # Validate zone name (domain name)
        if not isinstance(self.name, str):
            raise ValueError("Zone name must be a string")

        if not self.name:
            raise ValueError("Zone name cannot be empty")

        # Hetzner DNS only supports public domains with proper TLDs
        if not RE_PUBLIC_ZONE.match(self.name):
            raise ValueError(f"Invalid domain name format for zone: {self.name}")

        # Validate records and rrsets lists
        if not isinstance(self.records, list):
            raise ValueError("Records must be a list")

        if not isinstance(self.rrsets, list):
            raise ValueError("RRSets must be a list")

        if self.rrsets and self.records:
            raise ValueError("Zone must be initialized with records or rrsets, not both")

        if not self.rrsets:
            self.rrsets = records_to_rrsets(self.records)

        if not self.records:
            self.records = rrsets_to_records(self.rrsets)

        # Check for duplicate records (same type, name, and value)
        record_keys = set()
        for record in self.records:
            key = (record.type, record.name, record.value, record.comment)
            if key in record_keys:
                raise ValueError(f"Duplicate record found: {record.type} {record.name} {record.value}")
            record_keys.add(key)

        # Sort records and rrsets by type, then name
        self.records.sort(key=lambda r: (r.type, r.name))
        self.rrsets.sort(key=lambda rrset: (rrset.type, rrset.name))


def records_to_rrsets(records: Iterable[Record]) -> List[RRSet]:
    """Group flat records into RRSets."""
    grouped: Dict[Tuple[str, RecordType], List[Record]] = {}
    for record in records:
        grouped.setdefault((record.name, record.type), []).append(record)

    return [RRSet(name=name, type=record_type, records=records) for (name, record_type), records in grouped.items()]


def rrsets_to_records(rrsets: Iterable[RRSet]) -> List[Record]:
    """Flatten RRSets into legacy record rows."""
    records = []
    for rrset in rrsets:
        records.extend(rrset.records)
    return records


