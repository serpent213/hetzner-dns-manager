@click.group(invoke_without_command=True)
@click.option(
    "--dry",
    is_flag=True,
    help="Print the first API request that would be performed and then halt",
)
@click.option(
    "--version",
    is_flag=True,
    help="Show the version and exit",
)
@click.option(
    "--zones-dir",
    type=click.Path(file_okay=False, dir_okay=True, path_type=pathlib.Path),
    envvar="HDEM_ZONES_DIR",
    default=DEFAULT_ZONES_DIR,
    show_default="./zones",
    help="Directory containing zone YAML files. Can also be set with HDEM_ZONES_DIR.",
)
@click.pass_context
def cli(ctx: click.Context, dry: bool, version: bool, zones_dir: pathlib.Path) -> None:
    """
    Hetzner DNS Manager - Manage DNS records with Hetzner Cloud DNS API and local YAML database.

    Stores one YAML file per zone in the configured zones directory. Provides commands for importing,
    checking, updating, and deleting DNS records.

    Requires HCLOUD_TOKEN environment variable to be set to a valid Hetzner Cloud API token.
    """
    global ZONES_DIR
    ZONES_DIR = zones_dir.expanduser()

    if version:
        click.echo(f"{VERSION} (hdem)")
        ctx.exit(0)

    if ctx.invoked_subcommand is None:
        click.echo(ctx.get_help())
        ctx.exit(0)

    needs_api_token = ctx.invoked_subcommand in {"delete", "update"} or (
        ctx.invoked_subcommand == "import" and not dry
    )
    if needs_api_token and not API_TOKEN:
        console.print("[bold red]Error:[/] HCLOUD_TOKEN environment variable is not set.")
        ctx.exit(1)

    ctx.ensure_object(dict)
    ctx.obj["dry"] = dry

    if API_TOKEN:
        try:
            ctx.obj["client"] = require_hcloud_client(API_TOKEN)
        except RuntimeError as e:
            console.print(f"[bold red]Error:[/] {e}")
            ctx.exit(1)


@cli.command("import")
@click.argument("domain", required=False)
@click.option("--all", is_flag=True, help="Import all zones")
@click.option("--no-txt-concat", is_flag=True, help="Don't concatenate TXT record values")
@click.option(
    "--force",
    is_flag=True,
    help="Force overwrite existing zone files without confirmation",
)
@click.pass_context
def cli_import_zones(
    ctx: click.Context,
    domain: Optional[str],
    all: bool,
    no_txt_concat: bool,
    force: bool,
) -> None:
    """
    Import zones and records from the Hetzner Cloud DNS API.

    Specify a domain name to import a single zone, or use --all to import all zones.

    By default, TXT record values with multiple quoted parts (e.g., '"abc" "def"') will be
    concatenated into a single quoted value (e.g., '"abcdef"'). Use --no-txt-concat to
    disable this behavior.

    If a zone file already exists, you'll be prompted for confirmation before overwriting.
    Use --force to skip confirmation and overwrite existing files.
    """
    yaml_handler = YAMLHandler()

    try:
        if ctx.obj.get("dry"):
            print_dry_run(ctx, "get", "/zones")

        client = ctx.obj["client"]
        zones = client.zones.get_all(sort=["name:asc"])

        if not zones:
            console.print("[yellow]No zones found in your Hetzner Cloud project.[/]")
            return

        if all:
            # Import all zones
            for zone_data in zones:
                import_single_zone(zone_data, client, yaml_handler, no_txt_concat, force)

        elif domain:
            # Import specific zone
            zone_data = next((z for z in zones if z.name == domain), None)

            if not zone_data:
                console.print(f"[bold red]Error:[/] Domain '{domain}' not found in your Hetzner Cloud project.")
                return

            import_single_zone(zone_data, client, yaml_handler, no_txt_concat, force)

        else:
            console.print("[bold yellow]Please specify a domain or use --all flag.[/]")

    except click.exceptions.Exit:
        raise
    except Exception as e:
        console.print(f"[bold red]Error:[/] {str(e)}")
        ctx.exit(1)


@cli.command("migrate")
@click.argument("domain", required=False)
@click.option("--all", is_flag=True, help="Migrate all local zone files")
@click.pass_context
def cli_migrate_zones(ctx: click.Context, domain: Optional[str], all: bool) -> None:
    """
    Rewrite local zone files in the native RRSet format.

    Reading supports both legacy flat records and RRSet files. This command is the explicit path
    for converting existing legacy files to the RRSet format.
    """
    yaml_handler = YAMLHandler()

    try:
        if all:
            migrated = 0
            for file_path in ZONES_DIR.glob("*.yaml"):
                zone = yaml_handler.read_zone(file_path.stem)
                if zone is None:
                    continue
                if zone.source_format == "rrsets":
                    console.print(f"[yellow]Already RRSet format:[/] {zone.name}")
                    continue
                migrated += 1
                written_path = yaml_handler.write_zone(zone, file_format="rrsets")
                console.print(f"[green]Migrated:[/] {written_path}")

            if migrated == 0:
                console.print("[yellow]No legacy zone files found.[/]")
            return

        if domain:
            zone = yaml_handler.read_zone(domain)
            if not zone:
                console.print(f"[bold red]Error:[/] Domain '{domain}' not found in local database.")
                ctx.exit(1)

            if zone.source_format == "rrsets":
                console.print(f"[yellow]Zone '{domain}' is already in RRSet format.[/]")
                return

            written_path = yaml_handler.write_zone(zone, file_format="rrsets")
            console.print(f"[green]Migrated:[/] {written_path}")
            return

        console.print("[bold yellow]Please specify a domain or use --all flag.[/]")
        ctx.exit(1)

    except click.exceptions.Exit:
        raise
    except Exception as e:
        console.print(f"[bold red]Error:[/] {str(e)}")
        ctx.exit(1)


@cli.command("check")
@click.argument("domain", required=False)
@click.option("--all", is_flag=True, help="Check all zones")
@click.option(
    "--verbose",
    is_flag=True,
    help="Show detailed output for all zones, including those without errors",
)
@click.pass_context
def cli_check_zones(ctx: click.Context, domain: Optional[str], all: bool, verbose: bool) -> None:
    """
    Check DNS records against actual DNS entries.

    Specify a domain name to check a single zone, or use --all to check all zones.

    Note: Will not catch additional entries that are missing from the local database!
    """
    yaml_handler = YAMLHandler()
    found_issues = False

    try:
        if all:
            # Check all zones

            # For proper spacing using newlines
            newline_before_next_zone = False

            for file_path in ZONES_DIR.glob("*.yaml"):
                domain_name = file_path.stem
                zone = yaml_handler.read_zone(domain_name)
                if zone:
                    if newline_before_next_zone:
                        console.print("")

                    result = check_zone_records(ctx, zone, verbose)
                    if result["missing_records"] or result["mismatch_records"]:
                        found_issues = True

                    newline_before_next_zone = verbose or found_issues

            if found_issues:
                ctx.exit(1)

        elif domain:
            # Check specific zone
            zone = yaml_handler.read_zone(domain)

            if not zone:
                console.print(f"[bold red]Error:[/] Domain '{domain}' not found in local database.")
                ctx.exit(1)

            result = check_zone_records(ctx, zone, verbose)
            if result["missing_records"] or result["mismatch_records"]:
                ctx.exit(1)

        else:
            console.print("[bold yellow]Please specify a domain or use --all flag.[/]")
            ctx.exit(1)

    except click.exceptions.Exit:
        raise
    except Exception as e:
        console.print(f"[bold red]Error:[/] {str(e)}")
        ctx.exit(1)


@cli.command("delete")
@click.argument("domain", required=True)
@click.argument("record_names", required=True, nargs=-1)
@click.pass_context
def cli_delete_records(ctx: click.Context, domain: str, record_names: Tuple[str, ...]) -> None:
    """
    Delete one or more DNS records.

    Requires a domain name and one or more record names.
    """
    yaml_handler = YAMLHandler()
    client = ctx.obj["client"]

    try:
        zone = yaml_handler.read_zone(domain)

        if not zone:
            console.print(f"[bold red]Error:[/] Domain '{domain}' not found in local database.")
            ctx.exit(1)

        # Process each record name and handle multiple records with the same name
        records_to_delete = []
        missing_names = []

        for record_name in record_names:
            matching_records = [r for r in zone.records if r.name == record_name]

            if not matching_records:
                missing_names.append(record_name)
                continue

            if len(matching_records) == 1:
                # Only one record with this name
                record = matching_records[0]
                console.print(f"Found record: [bold]{record.type}[/] [green]{record_name}[/] [blue]{record.value}[/]")

                if click.confirm("Delete this record?", default=False):
                    records_to_delete.append(record)
            else:
                # Multiple records with the same name
                console.print(f"Found [bold]{len(matching_records)}[/] records with name '{record_name}':")

                # Ask for confirmation for each record
                for record in matching_records:
                    console.print(f"  - [bold]{record.type}[/] [green]{record_name}[/] [blue]{record.value}[/]")

                    if click.confirm("Delete this record?", default=False):
                        records_to_delete.append(record)

        # If any records weren't found, show warning but continue
        if missing_names:
            console.print(f"[bold yellow]Warning:[/] The following record(s) were not found in zone '{domain}':")
            for name in missing_names:
                console.print(f"  - {name}")

            # If no records were found at all, exit
            if not records_to_delete:
                console.print("\n[yellow]No records to delete. Exiting.[/]")
                ctx.exit(0)

        if not records_to_delete:
            console.print("\n[yellow]No records selected for deletion.[/]")
            ctx.exit(0)

        console.print(f"\n[bold]Summary:[/] {len(records_to_delete)} record(s) selected for deletion:")
        for record in records_to_delete:
            console.print(f"  - [bold]{record.type}[/] [green]{record.name}[/] [blue]{record.value}[/]")

        if not click.confirm("Proceed with deletion?", default=False):
            console.print("[yellow]Deletion canceled.[/]")
            ctx.exit(0)

        # Delete records from API by replacing or deleting their parent RRSets.
        deleted_records: List[Record] = []
        failed_deletions: List[Tuple[Record, str]] = []

        try:
            remote_zone = client.zones.get(zone.name)
        except Exception as e:
            console.print(f"[bold red]Error:[/] Could not fetch zone '{zone.name}' from Hetzner Cloud: {e}")
            ctx.exit(1)

        records_by_rrset: Dict[Tuple[str, RecordType], List[Record]] = {}
        for record in records_to_delete:
            records_by_rrset.setdefault((record.name, record.type), []).append(record)

        for (record_name, record_type), selected_records in records_by_rrset.items():
            if record_type == "SOA" or (record_name == "@" and record_type == "NS"):
                failed_deletions.extend(
                    (record, "Hetzner Cloud manages SOA and apex NS records strictly") for record in selected_records
                )
                continue

            local_rrset = next(
                (rrset for rrset in zone.rrsets if rrset.name == record_name and rrset.type == record_type),
                None,
            )
            if local_rrset is None:
                failed_deletions.extend((record, "Local RRSet not found") for record in selected_records)
                continue

            selected_keys = {(record.value, record.comment) for record in selected_records}
            remaining_records = [
                record for record in local_rrset.records if (record.value, record.comment) not in selected_keys
            ]

            try:
                rrset_identity = rrset_to_hcloud_rrset(remote_zone, local_rrset)
                if ctx.obj.get("dry"):
                    if remaining_records:
                        print_dry_run(
                            ctx,
                            "post",
                            f"/zones/{zone.name}/rrsets/{record_name}/{record_type}/actions/set_records",
                            {"records": [{"value": record.value} for record in remaining_records]},
                        )
                    else:
                        print_dry_run(ctx, "delete", f"/zones/{zone.name}/rrsets/{record_name}/{record_type}")

                if remaining_records:
                    action = client.zones.set_rrset_records(
                        rrset_identity,
                        records=[record_to_hcloud_record(record) for record in remaining_records],
                    )
                    wait_for_action(action)
                else:
                    response = client.zones.delete_rrset(rrset_identity)
                    wait_for_action(response.action)
                deleted_records.extend(selected_records)
            except click.exceptions.Exit:
                raise
            except Exception as e:
                failed_deletions.extend((record, str(e)) for record in selected_records)

        if deleted_records:
            console.print(f"[green]Successfully deleted {len(deleted_records)} record(s) from Hetzner Cloud DNS.[/]")

        if failed_deletions:
            console.print(f"[bold red]Failed to delete {len(failed_deletions)} record(s):[/]")
            for record, error in failed_deletions:
                display_name = record.name
                console.print(f"  - {record.type} {display_name}: {error}")

        if deleted_records:
            if click.confirm(
                "Do you want to update the YAML file to remove these records?",
                default=True,
            ):
                deleted_keys = {
                    (record.name, record.type, record.value, record.comment) for record in deleted_records
                }
                remaining_rrsets = []
                for rrset in zone.rrsets:
                    rrset.records = [
                        record
                        for record in rrset.records
                        if (record.name, record.type, record.value, record.comment) not in deleted_keys
                    ]
                    if rrset.records:
                        remaining_rrsets.append(rrset)
                zone.rrsets = remaining_rrsets
                zone.records = rrsets_to_records(zone.rrsets)

                # Save the updated zone
                file_path = yaml_handler.write_zone(zone)
                console.print(f"[green]Updated YAML file:[/] {file_path}")
            else:
                console.print(
                    f"\n[yellow]Please update the YAML file to remove deleted records:[/] {ZONES_DIR / f'{domain}.yaml'}"
                )

    except click.exceptions.Exit:
        raise
    except Exception as e:
        console.print(f"[bold red]Error:[/] {str(e)}")
        ctx.exit(1)


@cli.command("update")
@click.argument("domain", required=False)
@click.option("--all", is_flag=True, help="Update all zones")
@click.pass_context
def cli_update_zones(ctx: click.Context, domain: Optional[str], all: bool) -> None:
    """
    Check and update DNS records.

    Specify a domain name to update a single zone, or use --all to update all zones.
    """
    yaml_handler = YAMLHandler()
    client = ctx.obj["client"]

    try:
        if all:
            # Update all zones
            for file_path in ZONES_DIR.glob("*.yaml"):
                domain_name = file_path.stem
                zone = yaml_handler.read_zone(domain_name)
                if zone:
                    process_zone_update(ctx, zone, yaml_handler, client)

        elif domain:
            # Update specific zone
            zone = yaml_handler.read_zone(domain)

            if not zone:
                console.print(f"[bold red]Error:[/] Domain '{domain}' not found in local database.")
                ctx.exit(1)

            process_zone_update(ctx, zone, yaml_handler, client)

        else:
            console.print("[bold yellow]Please specify a domain or use --all flag.[/]")
            ctx.exit(1)

    except click.exceptions.Exit:
        raise
    except Exception as e:
        console.print(f"[bold red]Error:[/] {str(e)}")
        ctx.exit(1)


