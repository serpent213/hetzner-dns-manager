def process_txt_record_value(value: str, concat: bool = True) -> str:
    """
    Normalize TXT record values for consistency.

    Args:
        value: Original TXT record value
        concat: If True, concatenate segmented values ('"abc" "def"' → '"abcdef"')

    Returns:
        Processed TXT record value
    """
    if not concat or not value.startswith('"') or '"' not in value[1:]:
        return value

    # Extract content from quoted parts and concatenate
    # Matches quoted segments handling escaped quotes correctly
    parts = re.findall(r'"((?:[^"\\]|\\.)*)"', value)
    if parts:
        return f'"{("").join(parts)}"'

    return value


def hcloud_record_to_record(record_data: Any, rrset_name: str, rrset_type: RecordType) -> Record:
    """Convert an hcloud ZoneRecord into our record row."""
    return Record(
        id="",
        type=rrset_type,
        name=rrset_name,
        value=record_data.value,
        comment=getattr(record_data, "comment", None),
    )


def hcloud_rrset_to_rrset(rrset_data: Any, no_txt_concat: bool = False) -> RRSet:
    """Convert an hcloud ZoneRRSet into our RRSet model."""
    rrset_type = cast(RecordType, rrset_data.type)
    records = []
    for record_data in rrset_data.records or []:
        record = hcloud_record_to_record(record_data, rrset_data.name, rrset_type)
        if record.type == "TXT":
            record.value = process_txt_record_value(record.value, not no_txt_concat)
        records.append(record)

    return RRSet(
        name=rrset_data.name,
        type=rrset_type,
        ttl=rrset_data.ttl,
        labels=dict(rrset_data.labels or {}),
        records=records,
    )


def record_to_hcloud_record(record: Record) -> Any:
    """Convert our record row to hcloud's ZoneRecord."""
    if HCloudZoneRecord is None:
        raise RuntimeError("The 'hcloud' Python package is required. Install dependencies or run through uv.")
    return HCloudZoneRecord(value=record.value, comment=record.comment)


def rrset_to_hcloud_rrset(zone_ref: Any, rrset: RRSet) -> Any:
    """Convert our RRSet into hcloud's ZoneRRSet identity object."""
    if HCloudZoneRRSet is None:
        raise RuntimeError("The 'hcloud' Python package is required. Install dependencies or run through uv.")
    return HCloudZoneRRSet(
        name=rrset.name,
        type=rrset.type,
        ttl=rrset.ttl,
        labels=rrset.labels or None,
        records=[record_to_hcloud_record(record) for record in rrset.records],
        zone=zone_ref,
    )


def normalize_record_value(record_type: RecordType, value: str, zone_name: str) -> str:
    """Normalize record values for API/DNS comparisons."""
    match record_type:
        case "TXT":
            return "".join(re.findall(r'"((?:[^"\\]|\\.)*)"', value))
        case "CNAME" | "NS" | "PTR":
            return absolute_hostname(value, zone_name)
        case "MX":
            priority, host = value.split(" ", 1)
            return f"{priority} {absolute_hostname(host, zone_name)}"
        case "SRV":
            parts = value.split()
            if len(parts) >= 4:
                return " ".join([*parts[:3], absolute_hostname(parts[3], zone_name)])
            return value
        case _:
            return value


def absolute_hostname(hostname: str, zone_name: str) -> str:
    """Return an absolute DNS hostname with a trailing dot."""
    if hostname.endswith("."):
        return hostname
    return f"{hostname}.{zone_name}."


def rrset_records_equal(left: RRSet, right: RRSet, zone_name: str) -> bool:
    """Compare two RRSets by normalized values and comments."""
    left_values = sorted(
        (normalize_record_value(record.type, record.value, zone_name), record.comment or "")
        for record in left.records
    )
    right_values = sorted(
        (normalize_record_value(record.type, record.value, zone_name), record.comment or "")
        for record in right.records
    )
    return left_values == right_values and left.ttl == right.ttl


def wait_for_action(action: Any) -> None:
    """Wait for an hcloud action when the library returned one."""
    if hasattr(action, "wait_until_finished"):
        action.wait_until_finished()


def import_single_zone(
    zone_data: Any,
    client: Any,
    yaml_handler: YAMLHandler,
    no_txt_concat: bool = False,
    force: bool = False,
) -> Optional[pathlib.Path]:
    """
    Import a single zone from Hetzner Cloud DNS API to local YAML storage.

    Args:
        zone_data: Dict with zone metadata from API response
        client: hcloud-python client instance for API communication
        yaml_handler: YAMLHandler instance for file operations
        no_txt_concat: If True, preserve segmented TXT record format
        force: If True, overwrite existing zone files without prompting

    Returns:
        Path to the saved YAML file or None if import was canceled
    """
    zone_id = str(zone_data.id)
    zone_name = zone_data.name

    console.print(f"Importing zone: [bold]{zone_name}[/]")

    # Check if zone file already exists
    file_path = ZONES_DIR / f"{zone_name}.yaml"
    existing_format = yaml_handler.read_zone_format(zone_name)
    if file_path.exists() and not force:
        existing_zone = yaml_handler.read_zone(zone_name)
        if existing_zone:
            console.print(f"[yellow]Zone file already exists:[/] {file_path}")
            console.print(f"Existing file contains [bold]{len(existing_zone.records)}[/] records.")

            if not click.confirm("Do you want to overwrite the existing file?", default=False):
                console.print("[yellow]Import canceled for this zone.[/]")
                return None

    rrsets = [
        hcloud_rrset_to_rrset(rrset_data, no_txt_concat=no_txt_concat)
        for rrset_data in client.zones.get_rrset_all(zone_data)
    ]
    zone = Zone(
        id=zone_id,
        name=zone_name,
        ttl=zone_data.ttl,
        rrsets=rrsets,
        source_format=existing_format or "rrsets",
    )

    # Save zone to file
    file_path = yaml_handler.write_zone(zone)
    console.print(f"Saved to: [green]{file_path}[/] with [bold]{len(zone.records)}[/] records.")

    return file_path


def get_expected_hostname(hostname: str, zone_name: str) -> str:
    """
    Format hostname for DNS comparisons based on record format.

    Args:
        hostname: Record hostname (may be absolute with trailing dot or relative)
        zone_name: Zone/domain name for constructing FQDN

    Returns:
        Formatted hostname expected in DNS responses (without trailing dot)
    """
    # Check if this is an absolute hostname (ends with dot)
    if hostname.endswith("."):
        return hostname.rstrip(".")
    else:
        # It's a relative hostname, so append the zone name
        return f"{hostname}.{zone_name}"


def setup_dns_resolver(zone_name: str) -> dns.resolver.Resolver:
    """
    Set up a DNS resolver preferring authoritative nameservers for the zone.

    Args:
        zone_name: The zone/domain name to find authoritative nameservers for

    Returns:
        Configured DNS resolver instance
    """
    resolver = dns.resolver.Resolver()

    try:
        ns_answers = dns.resolver.resolve(zone_name, "NS")
        if ns_answers:
            # Set the first authoritative nameserver as our resolver
            auth_ns = str(ns_answers[0]).rstrip(".")

            nameserver_ips = []

            # Try IPv4 first
            try:
                a_records = dns.resolver.resolve(auth_ns, "A")
                for a_record in a_records:
                    nameserver_ips.append(str(a_record))
            except Exception:
                pass

            # Try IPv6 if available
            try:
                aaaa_records = dns.resolver.resolve(auth_ns, "AAAA")
                for aaaa_record in aaaa_records:
                    nameserver_ips.append(str(aaaa_record))
            except Exception:
                pass

            # If we got any nameserver IPs, use them
            if nameserver_ips:
                resolver.nameservers = nameserver_ips
    except Exception:
        # If we can't get authoritative nameservers, continue with default resolver
        pass

    return resolver


def check_dns_record(
    ctx: click.Context, record: Record, zone_name: str, resolver: dns.resolver.Resolver
) -> Tuple[str, Optional[int]]:
    """
    Verify if a DNS record matches its actual DNS entry using authoritative servers.

    Args:
        ctx: Click context for exit handling
        record: Record object to check against DNS
        zone_name: Zone/domain name the record belongs to
        resolver: DNS resolver to use for lookups (preconfigured for the zone)

    Returns:
        Tuple containing:
        - Status string: 'match', 'mismatch', or 'missing'
        - TTL value (if record exists, otherwise None)
    """

    try:
        # Handle domain name formatting
        if record.name == "@":
            query_name = zone_name
        else:
            query_name = f"{record.name}.{zone_name}"

        # Try to resolve the record to detect if it exists
        try:
            answers = resolver.resolve(query_name, record.type)

            # Get TTL from the first answer (all records in an RRset have the same TTL)
            ttl = answers.rrset.ttl if answers and answers.rrset else None

            match record.type:
                case "MX":
                    # MX records have priority and hostname, e.g., "10 mail.example.com."
                    priority, host = record.value.split(" ", 1)
                    priority_int = int(priority)

                    # Get expected hostname based on whether it's absolute or relative
                    expected_host = get_expected_hostname(host, zone_name)

                    for rdata in answers:
                        rdata_host = str(getattr(rdata, "exchange")).rstrip(".")
                        rdata_pref = getattr(rdata, "preference")

                        if rdata_host == expected_host and rdata_pref == priority_int:
                            return "match", ttl

                    return "mismatch", ttl

                case "TXT":
                    # Get the TXT record value from YAML
                    yaml_value = record.value

                    # Remove quotes if they are included in the YAML value
                    if yaml_value.startswith('"') and yaml_value.endswith('"'):
                        yaml_value = yaml_value[1:-1]

                    # Handle multi-part TXT records with spaces between quoted parts
                    yaml_value = yaml_value.replace('" "', "")

                    # Check if any of the returned TXT records match our expected value
                    for rdata in answers:
                        # DNSPython returns TXT records as bytes objects in a list
                        # First join all segments together
                        strings = getattr(rdata, "strings", [])
                        dns_value = "".join(str(t) for t in strings)

                        # Remove any 'b' prefixes that might appear in string representation of bytes
                        dns_value = dns_value.replace("b'", "").replace("'", "")

                        if dns_value == yaml_value:
                            return "match", ttl

                    return "mismatch", ttl

                case "CNAME":
                    expected_target = get_expected_hostname(record.value, zone_name)

                    for rdata in answers:
                        dns_target = str(rdata).rstrip(".")  # Remove trailing dot if present

                        if dns_target == expected_target:
                            return "match", ttl

                    return "mismatch", ttl

                case "NS":
                    expected_ns = get_expected_hostname(record.value, zone_name)

                    for rdata in answers:
                        dns_ns = str(rdata).rstrip(".")  # Remove trailing dot

                        if dns_ns == expected_ns:
                            return "match", ttl

                    return "mismatch", ttl

                case _:
                    # For other record types (A, AAAA, etc.)
                    for rdata in answers:
                        if str(rdata) == record.value:
                            return "match", ttl

                    return "mismatch", ttl

        except dns.resolver.NXDOMAIN:
            # Domain doesn't exist
            return "missing", None
        except dns.resolver.NoAnswer:
            # No answer from DNS for this record type
            return "missing", None

    except dns.resolver.NoNameservers:
        # No nameservers could be reached
        console.print(
            f"[bold red]Error:[/] checking DNS for {record.name}.{zone_name} ({record.type}): No nameservers could be reached"
        )
        ctx.exit(1)

    except Exception as e:
        # Any other error
        console.print(f"[bold red]Error:[/] checking DNS for {record.name}.{zone_name} ({record.type}): {e}")
        ctx.exit(1)


def check_zone_records(ctx: click.Context, zone: Zone, verbose: bool = False) -> Dict[str, List[Record]]:
    """
    Verify all zone records against live DNS and display comparison results.

    Args:
        ctx: Click context for exit handling
        zone: Zone object containing records to check
        verbose: If True, show detailed output for all zones, including those without errors

    Returns:
        Dict with missing_records and mismatch_records lists
    """
    missing_records = []
    mismatch_records = []

    # Set up DNS resolver for the zone pointing to authoritative servers
    resolver = setup_dns_resolver(zone.name)

    table = Table(show_header=True)
    table.add_column("Type", style="cyan")
    table.add_column("Name", style="green")
    table.add_column("Local Value", style="blue")
    table.add_column("TTL", style="magenta", justify="right")
    table.add_column("Status", style="bold")

    for record in zone.records:
        # Skip SOA records as they're modified by Hetzner upon update
        if record.type == "SOA":
            continue

        status_code, ttl = check_dns_record(ctx, record, zone.name, resolver)

        # If the record has an id, we assume a rename
        if status_code == "missing" and record.id:
            status_code = "mismatch"

        match status_code:
            case "match":
                status = "[green]✓ Match[/]"
            case "mismatch":
                status = "[red]✗ Mismatch[/]"
                mismatch_records.append(record)
            case "missing":
                status = "[red]✗ Missing[/]"
                missing_records.append(record)
            case _:
                status = f"[yellow]? Unknown ({status_code})[/]"

        ttl_str = str(ttl) if ttl is not None else "-"

        table.add_row(record.type, record.name, record.value, ttl_str, status)

    has_issues = bool(missing_records or mismatch_records)

    # Only print output if there are issues or verbose mode is enabled
    if has_issues or verbose:
        console.print(f"[bold]Checking zone:[/] {zone.name}")
        console.print(table)

        if not has_issues:
            console.print("[green]All records match the DNS entries.[/]")
        else:
            if mismatch_records:
                console.print("[yellow]Some records do not match the DNS entries.[/]")
            if missing_records:
                console.print("[yellow]Some records are missing from DNS.[/]")
    elif not verbose and not has_issues:
        # In non-verbose mode with no issues, just print a simple message
        console.print(f"[green]Zone {zone.name}: All records match.[/]")

    return {"missing_records": missing_records, "mismatch_records": mismatch_records}


def process_zone_update(ctx: click.Context, zone: Zone, yaml_handler: YAMLHandler, client: Any) -> bool:
    """
    Update zone records in Hetzner Cloud DNS API based on local YAML configuration.

    Args:
        ctx: Click context for exit handling
        zone: Zone object containing desired record state
        yaml_handler: YAMLHandler instance for file operations
        client: hcloud-python client instance for API communication

    Returns:
        True on updated zone, False on no update required
    """
    try:
        remote_zone = client.zones.get(zone.name)
        remote_rrsets = [hcloud_rrset_to_rrset(rrset_data) for rrset_data in client.zones.get_rrset_all(remote_zone)]
    except Exception as e:
        console.print(f"[bold red]Error:[/] Could not fetch zone '{zone.name}' from Hetzner Cloud: {e}")
        ctx.exit(1)

    local_rrsets = {(rrset.name, rrset.type): rrset for rrset in zone.rrsets if rrset.type != "SOA"}
    remote_rrsets_by_key = {(rrset.name, rrset.type): rrset for rrset in remote_rrsets if rrset.type != "SOA"}

    missing_rrsets = []
    mismatch_rrsets = []
    protected_rrsets = []

    for key, local_rrset in local_rrsets.items():
        remote_rrset = remote_rrsets_by_key.get(key)
        if remote_rrset is None:
            missing_rrsets.append(local_rrset)
        elif not rrset_records_equal(local_rrset, remote_rrset, zone.name):
            if local_rrset.name == "@" and local_rrset.type == "NS":
                protected_rrsets.append(local_rrset)
            else:
                mismatch_rrsets.append(local_rrset)

    extra_rrsets = [
        rrset
        for key, rrset in remote_rrsets_by_key.items()
        if key not in local_rrsets and not (rrset.name == "@" and rrset.type == "NS")
    ]

    added_remote_rrsets = False
    if extra_rrsets:
        console.print(
            f"\nFound [bold]{len(extra_rrsets)}[/] RRSet(s) present in Hetzner Cloud but missing from local YAML:"
        )
        for rrset in extra_rrsets:
            values = ", ".join(record.value for record in rrset.records)
            console.print(f"  - {rrset.type} {rrset.name}: {values}")

        if click.confirm("Do you want to add these RRSets to the local YAML file?", default=False):
            zone.rrsets.extend(extra_rrsets)
            zone.records = rrsets_to_records(zone.rrsets)
            file_path = yaml_handler.write_zone(zone)
            console.print(f"[green]Updated YAML file:[/] {file_path}")
            added_remote_rrsets = True

    # If no missing or mismatched records, nothing to do
    if not missing_rrsets and not mismatch_rrsets and not protected_rrsets:
        console.print("[green]All local records match Hetzner Cloud. No remote update needed.[/]")
        return added_remote_rrsets

    if protected_rrsets:
        console.print(
            "[yellow]Skipping apex NS mismatch; Hetzner Cloud manages authoritative NS records strictly.[/]"
        )

    # Handle missing RRSets first
    if missing_rrsets:
        console.print(f"\nFound [bold]{len(missing_rrsets)}[/] missing RRSet(s):")
        for rrset in missing_rrsets:
            values = ", ".join(record.value for record in rrset.records)
            console.print(f"  - {rrset.type} {rrset.name}: {values}")

        if click.confirm("Do you want to create the missing RRSets?", default=True):
            if ctx.obj.get("dry"):
                first_rrset = missing_rrsets[0]
                print_dry_run(
                    ctx,
                    "post",
                    f"/zones/{zone.name}/rrsets",
                    {
                        "name": first_rrset.name,
                        "type": first_rrset.type,
                        "records": [{"value": record.value} for record in first_rrset.records],
                    },
                )

            for rrset in missing_rrsets:
                try:
                    response = client.zones.create_rrset(
                        remote_zone,
                        name=rrset.name,
                        type=rrset.type,
                        ttl=rrset.ttl,
                        labels=rrset.labels or None,
                        records=[record_to_hcloud_record(record) for record in rrset.records],
                    )
                    wait_for_action(response.action)
                    console.print(f"[green]Created RRSet:[/] {rrset.id}")
                except click.exceptions.Exit:
                    raise
                except Exception as e:
                    console.print(f"[bold red]Failed to create RRSet {rrset.id}:[/] {e}")

    # Handle mismatched RRSets
    if mismatch_rrsets:
        console.print(f"\nFound [bold]{len(mismatch_rrsets)}[/] mismatched RRSet(s):")
        for rrset in mismatch_rrsets:
            values = ", ".join(record.value for record in rrset.records)
            console.print(f"  - {rrset.type} {rrset.name}: {values}")

        if click.confirm("Do you want to replace the mismatched RRSets?", default=True):
            if ctx.obj.get("dry"):
                first_rrset = mismatch_rrsets[0]
                print_dry_run(
                    ctx,
                    "post",
                    f"/zones/{zone.name}/rrsets/{first_rrset.name}/{first_rrset.type}/actions/set_records",
                    {"records": [{"value": record.value} for record in first_rrset.records]},
                )

            for rrset in mismatch_rrsets:
                try:
                    remote_identity = rrset_to_hcloud_rrset(remote_zone, rrset)
                    action = client.zones.set_rrset_records(
                        remote_identity,
                        records=[record_to_hcloud_record(record) for record in rrset.records],
                    )
                    wait_for_action(action)
                    if rrset.ttl is not None:
                        wait_for_action(client.zones.change_rrset_ttl(remote_identity, ttl=rrset.ttl))
                    console.print(f"[green]Updated RRSet:[/] {rrset.id}")
                except click.exceptions.Exit:
                    raise
                except Exception as e:
                    console.print(f"[bold red]Failed to update RRSet {rrset.id}:[/] {e}")

    return True


