class YAMLHandler:
    """Handler for YAML file operations."""

    def __init__(self) -> None:
        self.yaml = YAML()
        self.yaml.indent(mapping=2, sequence=4, offset=2)
        self.yaml.preserve_quotes = True

    def read_zone(self, domain: str) -> Optional[Zone]:
        """Read a zone file from disk."""
        file_path = ZONES_DIR / f"{domain}.yaml"

        if not file_path.exists():
            return None

        with open(file_path, "r") as f:
            data = self.yaml.load(f)

        if "rrsets" in data:
            return self._read_rrset_zone(data)

        return self._read_legacy_zone(data)

    def read_zone_format(self, domain: str) -> Optional[ZoneFileFormat]:
        """Return the format of an existing zone file without validating all records."""
        file_path = ZONES_DIR / f"{domain}.yaml"
        if not file_path.exists():
            return None

        with open(file_path, "r") as f:
            data = self.yaml.load(f)

        if "rrsets" in data:
            return "rrsets"
        return "legacy"

    def _read_legacy_zone(self, data: Dict[str, Any]) -> Zone:
        """Read the old flat records format."""
        records = []
        for record_data in data.get("records", []):
            record_type = cast(RecordType, record_data["type"])
            record_id = record_data.get("id") or ""
            records.append(
                Record(
                    id=str(record_id),
                    type=record_type,
                    name=record_data["name"],
                    value=record_data["value"],
                    comment=record_data.get("comment"),
                )
            )

        return Zone(
            id=str(data["id"]),
            name=data["name"],
            ttl=data.get("ttl"),
            records=records,
            source_format="legacy",
        )

    def _read_rrset_zone(self, data: Dict[str, Any]) -> Zone:
        """Read the native RRSet format."""
        rrsets = []
        for rrset_data in data.get("rrsets", []):
            record_type = cast(RecordType, rrset_data["type"])
            name = rrset_data["name"]
            records = []
            for record_data in rrset_data.get("records", []):
                if isinstance(record_data, str):
                    value = record_data
                    comment = None
                else:
                    value = record_data["value"]
                    comment = record_data.get("comment")

                records.append(
                    Record(
                        id="",
                        type=record_type,
                        name=name,
                        value=value,
                        comment=comment,
                    )
                )

            rrsets.append(
                RRSet(
                    name=name,
                    type=record_type,
                    ttl=rrset_data.get("ttl"),
                    labels=dict(rrset_data.get("labels") or {}),
                    records=records,
                )
            )

        return Zone(
            id=str(data["id"]),
            name=data["name"],
            ttl=data.get("ttl"),
            rrsets=rrsets,
            source_format="rrsets",
        )

    def write_zone(self, zone: Zone, file_format: Optional[ZoneFileFormat] = None) -> pathlib.Path:
        """Write a zone file to disk."""
        ZONES_DIR.mkdir(parents=True, exist_ok=True)
        file_path = ZONES_DIR / f"{zone.name}.yaml"
        target_format = file_format or zone.source_format

        if target_format == "legacy":
            data = self._zone_to_legacy_yaml(zone)
        else:
            data = self._zone_to_rrset_yaml(zone)

        with open(file_path, "w") as f:
            self.yaml.dump(data, f)

        zone.source_format = target_format
        return file_path

    def _zone_to_rrset_yaml(self, zone: Zone) -> Dict[str, Any]:
        """Serialize a zone to the v2 RRSet YAML shape."""
        data = {
            "version": 2,
            "id": zone.id,
            "name": zone.name,
            "rrsets": [self._rrset_to_yaml(rrset) for rrset in sorted(zone.rrsets, key=lambda r: (r.type, r.name))],
        }
        if zone.ttl is not None:
            data["ttl"] = zone.ttl
        return data

    def _zone_to_legacy_yaml(self, zone: Zone) -> Dict[str, Any]:
        """Serialize a zone to the legacy flat records YAML shape."""
        data: Dict[str, Any] = {
            "id": zone.id,
            "name": zone.name,
            "records": [
                self._legacy_record_to_yaml(record) for record in sorted(zone.records, key=lambda r: (r.type, r.name))
            ],
        }
        if zone.ttl is not None:
            data["ttl"] = zone.ttl
        return data

    def _rrset_to_yaml(self, rrset: RRSet) -> Dict[str, Any]:
        """Serialize an RRSet to the v2 YAML shape."""
        data: Dict[str, Any] = {
            "name": rrset.name,
            "type": rrset.type,
            "records": [
                self._record_to_yaml(record)
                for record in sorted(rrset.records, key=lambda r: (r.value, r.comment or ""))
            ],
        }
        if rrset.ttl is not None:
            data["ttl"] = rrset.ttl
        if rrset.labels:
            data["labels"] = rrset.labels
        return data

    def _record_to_yaml(self, record: Record) -> Dict[str, Any]:
        """Serialize a record value inside an RRSet."""
        data = {"value": record.value}
        if record.comment:
            data["comment"] = record.comment
        return data

    def _legacy_record_to_yaml(self, record: Record) -> Dict[str, Any]:
        """Serialize a record row in the old flat format."""
        data = {
            "id": record.id,
            "type": record.type,
            "name": record.name,
            "value": record.value,
        }
        if record.comment:
            data["comment"] = record.comment
        return data


